# Konfigurasi Midtrans QRIS — Azzatul Bouquet
# 1. Daftar / login gratis di https://dashboard.sandbox.midtrans.com
# 2. Masuk ke Settings -> Access Keys -> salin "Server Key" (diawali SB-Mid-server-...)
# 3. Tempelkan ke MIDTRANS_SERVER_KEY di bawah ini dan simpan file .env
#    (Perubahan pada .env langsung aktif otomatis tanpa perlu me-restart npm run dev)

MIDTRANS_SERVER_KEY=
MIDTRANS_IS_PRODUCTION=false

# Konfigurasi Database Cloud Supabase (Opsional — untuk sinkronisasi lintas HP & Laptop)
# 1. Buat proyek gratis di https://supabase.com
# 2. Jalankan isi file supabase-schema.sql di SQL Editor Supabase
# 3. Salin Project URL & service_role key (Project Settings -> API) ke bawah ini & ke Vercel Env Vars
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
